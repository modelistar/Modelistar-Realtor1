<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>MODELISTAR | Trusted Realtor</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="MODELISTAR – Trusted Realtor for lands and houses.">
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', Arial, sans-serif;
      background: #f5f7fa;
      color: #333;
    }
    header {
      background: linear-gradient(135deg, #0b3d91, #1e90ff);
      color: white;
      padding: 60px 20px;
      text-align: center;
    }
    header h1 {
      font-size: 38px;
      margin-bottom: 10px;
    }
    header p {
      font-size: 18px;
      opacity: 0.95;
    }
    .btn {
      display: inline-block;
      margin-top: 20px;
      padding: 14px 28px;
      background: #ffffff;
      color: #0b3d91;
      text-decoration: none;
      border-radius: 30px;
      font-weight: bold;
    }
    section {
      max-width: 1100px;
      margin: auto;
      padding: 50px 20px;
    }
    h2 {
      text-align: center;
      color: #0b3d91;
      margin-bottom: 30px;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }
    .card {
      background: white;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
      text-align: center;
    }
    .card h3 {
      margin-bottom: 10px;
      color: #0b3d91;
    }
    .contact {
      background: #0b3d91;
      color: white;
      padding: 50px 20px;
      text-align: center;
    }
    .contact a {
      color: white;
      font-weight: bold;
      text-decoration: none;
    }
    footer {
      background: #111;
      color: #aaa;
      text-align: center;
      padding: 15px;
      font-size: 14px;
    }
  </style>
</head>
<body>

<header>
  <h1>MODELISTAR</h1>

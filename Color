  <a class="btn" href="https://wa.me/234XXXXXXXXXX">Chat on WhatsApp</a>
</header>

<section>
  <h2>Why Work With Me</h2>
  <div class="cards">
    <div class="card">
      <h3>Verified Properties</h3>
      <p>All lands and houses are properly checked and verified.</p>
    </div>
    <div class="card">
      <h3>Trusted Process</h3>
      <p>Clear documentation and transparent transactions.</p>
    </div>
    <div class="card">
      <h3>Client Satisfaction</h3>
      <p>Your peace of mind is my priority.</p>
    </div>
  </div>
</section>

<section>

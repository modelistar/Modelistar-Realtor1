<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>MODELISTAR | Trusted Realtor</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="MODELISTAR – Trusted Realtor helping clients buy, sell, and invest in properties.">
  <style>
    /* Global Styles */
    body {
      margin: 0;
      font-family: 'Segoe UI', Arial, sans-serif;
      background: #f5f7fa;
      color: #333;
    }
    a { text-decoration: none; }

    /* Header */
    header {
      background: linear-gradient(135deg, #0b3d91, #1e90ff);
      color: white;
      padding: 60px 20px;
      text-align: center;
    }
    header h1 {
      font-size: 38px;
      margin-bottom: 10px;
    }
    header p {
      font-size: 18px;
      opacity: 0.95;
    }
    .btn {
      display: inline-block;
      margin-top: 20px;
      padding: 14px 28px;
      background: white;
      color: #0b3d91;
      font-weight: bold;
      border-radius: 30px;
      transition: 0.3s;
    }
    .btn:hover { background: #ddd; }

    /* Section */
    section {
      max-width: 1100px;
      margin: auto;
      padding: 50px 20px;
    }
    h2 {
      text-align: center;
      color: #0b3d91;
      margin-bottom: 30px;
    }

    /* Cards */
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }
    .card {
      background: white;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
      text-align: center;
      transition: transform 0.3s;
    }
    .card:hover { transform: translateY(-5px); }
    .card h3 { color: #0b3d91; margin-bottom: 10px; }

    /* Contact Section */
    .contact {
      background: #0b3d91;
      color: white;
      padding: 50px 20px;
      text-align: center;
    }
    .contact a { color: white; font-weight: bold; }

    /* Footer */
    footer {
      background: #111;
      color: #aaa;
      text-align: center;
      padding: 15px;
      font-size: 14px;
    }

    /* WhatsApp Floating Button */
    #whatsapp-float {
      position: fixed;
      bottom: 20px;
      right: 20px;
      width: 60px;
      height: 60px;
      z-index: 100;
      border-radius: 50%;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      background: #25D366;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.3s;
    }
    #whatsapp-float:hover { transform: scale(1.1); }
    #whatsapp-float img { width: 35px; height: 35px; }
  </style>
</head>
<body>

<header>
  <h1>MODELISTAR</h1>
  <p>Trusted Realtor | Land & Property Consultant</p>
  <a class="btn" href="https://wa.me/234XXXXXXXXXX">Chat on WhatsApp</a>
</header>

<section>
  <h2>Why Work With Me</h2>
  <div class="cards">
    <div class="card">
      <h3>Verified Properties</h3>
      <p>All lands and houses are properly checked and verified for your safety.</p>
    </div>
    <div class="card">
      <h3>Trusted Process</h3>
      <p>Clear documentation and transparent transactions every step of the way.</p>
    </div>
    <div class="card">
      <h3>Client Satisfaction</h3>
      <p>Your peace of mind and satisfaction is my top priority.</p>
    </div>
  </div>
</section>

<section>
  <h2>My Services</h2>
  <div class="cards">
    <div class="card">Land Sales</div>
    <div class="card">House Sales</div>
    <div class="card">Property Inspection</div>
    <div class="card">Documentation Assistance</div>
  </div>
</section>

<div class="contact">
  <h2>Contact MODELISTAR</h2>
  <p>Phone / WhatsApp: +234XXXXXXXXXX</p>
  <p>Email: yourname@email.com</p>
  <p><a href="https://wa.me/234XXXXXXXXXX" target="_blank">Click here to chat on WhatsApp</a></p>
</div>

<footer>
  © 2026 MODELISTAR. All Rights Reserved.
</footer>

<!-- WhatsApp Floating Button -->
<a href="https://wa.me/234XXXXXXXXXX" target="_blank" id="whatsapp-float">
  <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" alt="Chat on WhatsApp">
</a>

</body>
</html>
